{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Дизайн-токены «Архитектора» (Linear-канон). Экспорт из architect/styles.css. Тёмная тема — канон ($value); светлые значения — в $extensions com.architect.theme.light. Формат DTCG (Design Token Community Group).",
  "color": {
    "$type": "color",
    "surface": {
      "$description": "Лестница поверхностей — глубина светлотой, не тенями",
      "base":   { "$value": "#08090a", "$extensions": { "com.architect.theme.light": "#F2F1EC" } },
      "panel":  { "$value": "#0f1011", "$extensions": { "com.architect.theme.light": "#FBFAF7" } },
      "raised": { "$value": "#141516", "$extensions": { "com.architect.theme.light": "#FFFFFF" } },
      "hover":  { "$value": "#18191a", "$extensions": { "com.architect.theme.light": "#F1EFE9" } },
      "overlay":{ "$value": "#191a1b", "$extensions": { "com.architect.theme.light": "#FFFFFF" } }
    },
    "border": {
      "$description": "Hairline-границы вместо теней",
      "subtle": { "$value": "#23252a", "$extensions": { "com.architect.theme.light": "#E7E4DE" } },
      "medium": { "$value": "#34343a", "$extensions": { "com.architect.theme.light": "#D9D6CE" } },
      "strong": { "$value": "#3e3e44", "$extensions": { "com.architect.theme.light": "#C8C5BC" } }
    },
    "text": {
      "$description": "4 уровня контраста",
      "primary":   { "$value": "#f7f8f8", "$extensions": { "com.architect.theme.light": "#1C1B17" } },
      "secondary": { "$value": "#d0d6e0", "$extensions": { "com.architect.theme.light": "#4A4842" } },
      "tertiary":  { "$value": "#8a8f98", "$extensions": { "com.architect.theme.light": "#8B887F" } },
      "quaternary":{ "$value": "#62666d", "$extensions": { "com.architect.theme.light": "#B7B4AB" } }
    },
    "accent": {
      "$description": "ЕДИНСТВЕННЫЙ акцент + 2 hover-оттенка (индиго-рампа), одинаков в обеих темах",
      "default": { "$value": "#5e6ad2" },
      "hover":   { "$value": "#7170ff" },
      "light":   { "$value": "#828fff" }
    },
    "status": {
      "$description": "Только функционально — успех/ошибка/внимание",
      "success": { "$value": "#27a644", "$extensions": { "com.architect.theme.light": "#1F8A3C" } },
      "danger":  { "$value": "#e5484d", "$extensions": { "com.architect.theme.light": "#D64545" } },
      "warning": { "$value": "#c78d45", "$extensions": { "com.architect.theme.light": "#B0722A" } }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "8px-база: 4/8/12/16/24/32/48",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Форма: chip / карточка-инпут / модалка / pill",
    "chip":  { "$value": "4px" },
    "card":  { "$value": "8px" },
    "modal": { "$value": "12px" },
    "pill":  { "$value": "9999px" }
  },
  "fontSize": {
    "$type": "dimension",
    "$description": "Типо-шкала Linear: 12/13/15/18/24/32",
    "xs":  { "$value": "12px" },
    "sm":  { "$value": "13px" },
    "md":  { "$value": "15px" },
    "lg":  { "$value": "18px" },
    "xl":  { "$value": "24px" },
    "2xl": { "$value": "32px" }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "sans": { "$value": ["Inter", "-apple-system", "SF Pro Text", "system-ui", "sans-serif"] }
  },
  "duration": {
    "$type": "duration",
    "$description": "Движение инженерное, без пружин",
    "fast": { "$value": "80ms" },
    "base": { "$value": "120ms" },
    "slow": { "$value": "150ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Теней нет — глубина только поверхностями. Токен для явности.",
    "none": { "$value": [] }
  }
}
