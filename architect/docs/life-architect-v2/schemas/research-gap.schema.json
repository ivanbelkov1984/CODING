{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architect.local/schemas/research-gap.schema.json",
  "title": "research-gap",
  "description": "Research or licensing gap with safe default and explicit release consequences.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "schemaVersion": {"type": "integer", "minimum": 1},
    "source": {"type": "object"},
    "provenance": {"type": "object"},
    "privacyClass": {"type": "string"},
    "verificationStatus": {"type": "string"},
    "gapId": {"type": "string"},
    "category": {"type": "string"},
    "blockedDecision": {"type": "string"},
    "knownEvidence": {"type": "array", "items": {"type": "string"}},
    "missingEvidence": {"type": "array", "items": {"type": "string"}},
    "exactResearchQuestion": {"type": "string"},
    "acceptableSourceTypes": {"type": "array", "items": {"type": "string"}},
    "safeDefault": {"type": "string"},
    "parallelWorkAllowed": {"type": "boolean"},
    "blocksCode": {"type": "boolean"},
    "blocksRelease": {"type": "boolean"},
    "owner": {"type": "string"},
    "closureCriteria": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["open", "in_research", "closed", "wont_fix"]}
  },
  "required": ["id", "profileId", "createdAt", "schemaVersion", "gapId", "category", "blockedDecision", "exactResearchQuestion", "safeDefault", "blocksCode", "blocksRelease", "owner", "closureCriteria", "status"]
}
