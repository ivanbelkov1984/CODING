{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architect.local/schemas/lab-observation.schema.json",
  "title": "lab-observation",
  "description": "Source-bound laboratory observation; draft extraction cannot enter longitudinal analysis.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "schemaVersion": {"type": "integer", "minimum": 1},
    "source": {"type": "object"},
    "provenance": {"type": "object"},
    "privacyClass": {"type": "string"},
    "verificationStatus": {"type": "string"},
    "sourceDocumentId": {"type": "string"},
    "testNameOriginal": {"type": "string"},
    "terminology": {"type": ["object", "null"]},
    "valueOriginal": {},
    "unitOriginal": {"type": ["string", "null"]},
    "normalized": {"type": ["object", "null"]},
    "referenceRange": {"type": ["object", "null"]},
    "sourceFlag": {"type": ["string", "null"]},
    "specimen": {"type": ["string", "null"]},
    "method": {"type": ["string", "null"]},
    "collectedAt": {"type": ["string", "null"], "format": "date-time"},
    "fieldEvidence": {"type": "array", "items": {"type": "object"}},
    "acceptedByUser": {"type": "boolean"}
  },
  "required": ["id", "profileId", "createdAt", "schemaVersion", "sourceDocumentId", "testNameOriginal", "acceptedByUser"]
}
