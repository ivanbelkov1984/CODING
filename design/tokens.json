{
  "$description": "Дизайн-токены Архитектора (Linear-канон): механический экспорт из architect/styles.css. Тёмная тема — канон ($value); светлая — в $extensions.studio.theme.light. Регенерация: node design/build-tokens.mjs.",
  "color": {
    "surface": {
      "base": {
        "$value": "#08090a",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--bg-base"
        }
      },
      "panel": {
        "$value": "#0f1011",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--bg-panel"
        }
      },
      "s2": {
        "$value": "#141516",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--bg-surface-2"
        }
      },
      "s3": {
        "$value": "#18191a",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--bg-surface-3"
        }
      },
      "s4": {
        "$value": "#191a1b",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--bg-surface-4"
