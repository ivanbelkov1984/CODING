    },
    "graph": {
      "book": {
        "$value": "var(--accent)",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--c-book"
        }
      },
      "bot": {
        "$value": "var(--accent-light)",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--c-bot"
        }
      },
      "personal": {
        "$value": "#8a8f98",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--c-personal"
        }
      },
      "project": {
        "$value": "var(--accent-hover)",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--c-project"
        }
      },
      "vitality": {
        "$value": "rgba(94, 106, 210, .45)",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--c-vitality"
