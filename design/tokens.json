  "fontFamily": {
    "base": {
      "$value": "'Inter',-apple-system,'SF Pro Text',system-ui,sans-serif",
      "$type": "fontFamily",
      "$extensions": {
        "studio.cssVar": "--f"
      }
    }
  },
  "easing": {
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ],
      "$type": "cubicBezier",
      "$extensions": {
        "studio.cssVar": "--e"
      }
    }
  },
  "duration": {
    "fast": {
      "$value": "80ms",
      "$type": "duration",
      "$extensions": {
        "studio.cssVar": "--dur1"
      }
    },
    "base": {
      "$value": "120ms",
      "$type": "duration",
      "$extensions": {
        "studio.cssVar": "--dur2"
      }
    },
    "slow": {
      "$value": "150ms",
      "$type": "duration",
      "$extensions": {
        "studio.cssVar": "--dur3"
      }
    }
  },
  "$extensions": {
    "studio.source": "architect/styles.css (:root + [data-theme=\"light\"])",
    "studio.order": "#222 / #223",
    "studio.theme.light": {
      "color.surface.base": "#F2F1EC",
      "color.surface.panel": "#FBFAF7",
      "color.surface.s2": "#FFFFFF",
      "color.surface.s3": "#F1EFE9",
      "color.surface.s4": "#FFFFFF",
      "color.border.subtle": "#E7E4DE",
      "color.border.medium": "#D9D6CE",
      "color.border.strong": "#C8C5BC",
      "color.text.primary": "#1C1B17",
      "color.text.secondary": "#4A4842",
      "color.text.tertiary": "#8B887F",
      "color.text.quaternary": "#B7B4AB",
      "color.status.success": "#1F8A3C",
      "color.status.successSoft": "rgba(31, 138, 60, .10)",
      "color.status.danger": "#D64545",
      "color.status.dangerSoft": "rgba(214, 69, 69, .10)",
      "color.status.warning": "#B0722A",
      "color.status.warningSoft": "rgba(176, 114, 42, .10)",
      "color.heatmap.high": "rgba(94, 106, 210, .55)",
      "color.heatmap.low": "rgba(94, 106, 210, .30)",
      "color.heatmap.empty": "#E9E7E1",
      "shadow.sm": "0 3px 10px rgba(28,27,23,.14)",
      "shadow.md": "0 5px 16px rgba(28,27,23,.16)",
      "shadow.lg": "0 8px 24px rgba(28,27,23,.18)"
