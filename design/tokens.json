        "$value": "#d0d6e0",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--t2"
        }
      },
      "tertiary": {
        "$value": "#8a8f98",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--t3"
