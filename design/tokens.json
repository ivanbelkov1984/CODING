      "soft": {
        "$value": "rgba(94, 106, 210, .13)",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--blue-l"
        }
      }
    },
    "status": {
      "success": {
        "$value": "#27a644",
        "$type": "color",
        "$extensions": {
          "studio.cssVar": "--green"
        }
      },
      "successSoft": {
        "$value": "rgba(39, 166, 68, .12)",
